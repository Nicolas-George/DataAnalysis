import requests
import json

SERVICE_KEY = "75675a79636b6f693531756a4f7066" 
ENDPOINT = "http://openapi.seoul.go.kr:8088"
DATA_TYPE = "json"
SERVICE_NAME = "서울시 에코마일리지 에너지사용량 통계정보(회원유형별)"
START_INDEX = 1
END_INDEX = 100

url = f"{ENDPOINT}/{SERVICE_KEY}/{DATA_TYPE}/{SERVICE_NAME}/{START_INDEX}/{END_INDEX}/"

response = requests.get(url)

if response.status_code == 200:
    data = response.json()
    print(json.dumps(data, indent=4, ensure_ascii=False))
else:
    print(f"API 요청 실패: {response.status_code}")
